# --- Waveshare ESP32-S3-POE-ETH-CAM-KIT (ESP32-S3 + W5500 + OV2640) ---
CONFIG_PROBE_BOARD_S3_POE_ETH_CAM=y
CONFIG_PROBE_CAMERA=y

# 16 MB flash, 8 MB octal PSRAM (Waveshare ships N16R8 module).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# W5500 lives on SPI; no internal EMAC.
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Camera buffers want lots of contiguous DMA-capable memory.
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
