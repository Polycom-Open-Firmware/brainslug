# --- Common defaults across all probe targets. ---
# Per-target overrides live in sdkconfig.defaults.<target>.
# Pick target with `idf.py set-target esp32` or `idf.py set-target esp32s3`.

# --- partition table with two OTA slots ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_APP_ROLLBACK_ENABLE=y

# --- httpd / lwip — headroom for OTA upload, multi-UART, WS streamer ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16

# --- log level ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- main task stack ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
